set(_asset_source "@CMAKE_CURRENT_SOURCE_DIR@/assets")
set(_asset_destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@NUMTILO_INSTALL_ASSET_PARENT@/assets")
file(REAL_PATH "${_asset_source}" _asset_source_resolved)
set(_asset_ancestor "${_asset_destination}")
set(_asset_suffix "")
while (NOT EXISTS "${_asset_ancestor}")
    if (IS_SYMLINK "${_asset_ancestor}")
        message(FATAL_ERROR "Installed asset destination has a dangling symlink ancestor")
    endif()
    get_filename_component(_asset_name "${_asset_ancestor}" NAME)
    get_filename_component(_asset_parent "${_asset_ancestor}" DIRECTORY)
    if (_asset_parent STREQUAL _asset_ancestor OR _asset_parent STREQUAL "")
        message(FATAL_ERROR "Installed asset destination has no existing ancestor")
    endif()
    set(_asset_suffix "/${_asset_name}${_asset_suffix}")
    set(_asset_ancestor "${_asset_parent}")
endwhile()
file(REAL_PATH "${_asset_ancestor}" _asset_destination_resolved)
string(APPEND _asset_destination_resolved "${_asset_suffix}")
if (_asset_source_resolved STREQUAL _asset_destination_resolved)
    return()
endif()
cmake_path(IS_PREFIX _asset_destination_resolved "${_asset_source_resolved}" NORMALIZE _source_inside_destination)
cmake_path(IS_PREFIX _asset_source_resolved "${_asset_destination_resolved}" NORMALIZE _destination_inside_source)
if (_source_inside_destination OR _destination_inside_source)
    message(FATAL_ERROR "Installed asset destination cannot overlap source assets")
endif()
file(REMOVE_RECURSE "${_asset_destination}")
