if (NOT IS_DIRECTORY "${NUMTILO_ASSET_SOURCE}")
    message(FATAL_ERROR "Runtime asset source is not a directory: ${NUMTILO_ASSET_SOURCE}")
endif()
if (NOT IS_ABSOLUTE "${NUMTILO_ASSET_DESTINATION}")
    message(FATAL_ERROR "Runtime asset destination must be absolute")
endif()

file(REAL_PATH "${NUMTILO_ASSET_SOURCE}" _asset_source)
# Resolve the existing ancestor as well: a missing leaf below a directory symlink
# must not disguise an output nested inside the source tree.
set(_asset_ancestor "${NUMTILO_ASSET_DESTINATION}")
set(_asset_suffix "")
while (NOT EXISTS "${_asset_ancestor}")
    if (IS_SYMLINK "${_asset_ancestor}")
        message(FATAL_ERROR "Runtime asset destination has a dangling symlink ancestor")
    endif()
    get_filename_component(_asset_name "${_asset_ancestor}" NAME)
    get_filename_component(_asset_parent "${_asset_ancestor}" DIRECTORY)
    if (_asset_parent STREQUAL _asset_ancestor OR _asset_parent STREQUAL "")
        message(FATAL_ERROR "Runtime asset destination has no existing ancestor")
    endif()
    set(_asset_suffix "/${_asset_name}${_asset_suffix}")
    set(_asset_ancestor "${_asset_parent}")
endwhile()
file(REAL_PATH "${_asset_ancestor}" _asset_destination)
string(APPEND _asset_destination "${_asset_suffix}")
if (_asset_source STREQUAL _asset_destination)
    # An in-source command-line build already has its assets in the required location.
    return()
endif()
cmake_path(IS_PREFIX _asset_destination "${_asset_source}" NORMALIZE _source_inside_destination)
cmake_path(IS_PREFIX _asset_source "${_asset_destination}" NORMALIZE _destination_inside_source)
if (_source_inside_destination OR _destination_inside_source)
    message(FATAL_ERROR "Runtime asset source and destination cannot overlap")
endif()

file(REMOVE_RECURSE "${NUMTILO_ASSET_DESTINATION}")
file(MAKE_DIRECTORY "${NUMTILO_ASSET_DESTINATION}")
file(COPY "${NUMTILO_ASSET_SOURCE}/" DESTINATION "${NUMTILO_ASSET_DESTINATION}"
     PATTERN ".DS_Store" EXCLUDE PATTERN "._*" EXCLUDE)
