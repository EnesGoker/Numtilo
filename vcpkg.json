{
  "name": "numtilo",
  "version-string": "0.2.1",
  "description": "2048 desktop game in C++ with SFML",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "nlohmann-json"
  ],
  "default-features": [
    "desktop",
    "tests"
  ],
  "features": {
    "desktop": {
      "description": "SFML desktop application, graphics and audio dependencies",
      "dependencies": [
        "sfml",
        "fmt"
      ]
    },
    "tests": {
      "description": "Catch2 backend unit tests",
      "dependencies": [
        "catch2"
      ]
    }
  },
  "overrides": [
    {
      "name": "sfml",
      "version": "2.6.2"
    },
    {
      "name": "catch2",
      "version": "3.7.1"
    }
  ]
}